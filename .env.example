# ============================================================
# Environment variables.
# Copy this file to ".env" for local dev, and set the same
# variables in Vercel/Netlify for production.
#
# LEAVE THESE EMPTY to run in DEMO MODE (browser storage, instant).
# FILL THEM to enable real, unlimited multi-user mode.
# ============================================================

# From Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# From the Google Apps Script web-app deployment (optional)
VITE_SHEETS_WEBHOOK=
